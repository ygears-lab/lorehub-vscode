{
  "name": "lorehub-vscode",
  "displayName": "LoreHub",
  "description": "%extension.description%",
  "version": "0.0.1",
  "publisher": "YGears",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ygears-lab/lorehub-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/ygears-lab/lorehub-vscode/issues"
  },
  "homepage": "https://github.com/ygears-lab/lorehub-vscode#readme",
  "keywords": [
    "ai",
    "claude",
    "claude-code",
    "cursor",
    "copilot",
    "agents.md",
    "skill.md",
    "cursorrules",
    "markdown",
    "prompt",
    "sync"
  ],
  "categories": [
    "AI",
    "Other"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#22272E",
    "theme": "dark"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.104.0"
  },
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "configuration": {
      "title": "LoreHub",
      "properties": {
        "lorehub.statusBar.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "%configuration.statusBar.enabled.description%"
        }
      }
    },
    "commands": [
      {
        "command": "lorehub.login",
        "title": "%command.login.title%",
        "category": "LoreHub"
      },
      {
        "command": "lorehub.logout",
        "title": "%command.logout.title%",
        "category": "LoreHub"
      },
      {
        "command": "lorehub.openMdPanel",
        "title": "%command.openMdPanel.title%",
        "shortTitle": "LoreHub",
        "category": "LoreHub",
        "icon": "$(book)"
      },
      {
        "command": "lorehub.loadToProject",
        "title": "%command.loadToProject.title%",
        "category": "LoreHub",
        "icon": "$(cloud-download)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "lorehub.login",
          "when": "!lorehub.authenticated"
        },
        {
          "command": "lorehub.logout",
          "when": "lorehub.authenticated"
        }
      ],
      "editor/title": [
        {
          "command": "lorehub.openMdPanel",
          "when": "resourceFilename =~ /^(CLAUDE|AGENTS|SKILL)\\.md$|^\\.cursorrules$/i",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "lorehub.loadToProject",
          "when": "explorerResourceIsFolder",
          "group": "7_modification@1"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "lorehub.gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "featuredFor": [
          "CLAUDE.md",
          "AGENTS.md",
          "SKILL.md",
          ".cursorrules"
        ],
        "steps": [
          {
            "id": "signIn",
            "title": "%walkthrough.signIn.title%",
            "description": "%walkthrough.signIn.description%",
            "media": {
              "svg": "media/walkthrough/sign-in.svg",
              "altText": "%walkthrough.signIn.altText%"
            },
            "completionEvents": [
              "onContext:lorehub.authenticated"
            ]
          },
          {
            "id": "openLibrary",
            "title": "%walkthrough.openLibrary.title%",
            "description": "%walkthrough.openLibrary.description%",
            "media": {
              "svg": "media/walkthrough/library.svg",
              "altText": "%walkthrough.openLibrary.altText%"
            },
            "completionEvents": [
              "onCommand:lorehub.openMdPanel"
            ]
          },
          {
            "id": "loadIntoProject",
            "title": "%walkthrough.loadIntoProject.title%",
            "description": "%walkthrough.loadIntoProject.description%",
            "media": {
              "svg": "media/walkthrough/load.svg",
              "altText": "%walkthrough.loadIntoProject.altText%"
            },
            "completionEvents": [
              "onCommand:lorehub.loadToProject"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.104.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "supabase": "^2.116.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
