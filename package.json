{
  "name": "lorehub-vscode",
  "displayName": "LoreHub",
  "description": "Keep your CLAUDE.md, SKILL.md, .cursorrules and AGENTS.md files in one cloud-synced library, organize them with labels, and load them into any project without leaving VS Code.",
  "version": "0.0.1",
  "publisher": "YGears",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ygears-lab/lorehub-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/ygears-lab/lorehub-vscode/issues"
  },
  "homepage": "https://github.com/ygears-lab/lorehub-vscode#readme",
  "keywords": [
    "ai",
    "claude",
    "claude-code",
    "cursor",
    "copilot",
    "agents.md",
    "skill.md",
    "cursorrules",
    "markdown",
    "prompt",
    "sync"
  ],
  "categories": [
    "AI",
    "Other"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#22272E",
    "theme": "dark"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.104.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onUri"
  ],
  "contributes": {
    "commands": [
      {
        "command": "lorehub.login",
        "title": "Login with GitHub",
        "category": "LoreHub"
      },
      {
        "command": "lorehub.logout",
        "title": "Logout",
        "category": "LoreHub"
      },
      {
        "command": "lorehub.openMdPanel",
        "title": "Open My md Files",
        "category": "LoreHub"
      },
      {
        "command": "lorehub.loadToProject",
        "title": "Load md into Project",
        "category": "LoreHub"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.104.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "supabase": "^2.116.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
