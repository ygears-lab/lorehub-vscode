{
  "name": "lorehub-vscode",
  "displayName": "LoreHub",
  "description": "Keep your CLAUDE.md, SKILL.md, .cursorrules and AGENTS.md files in one cloud-synced library, organize them with labels, and load them into any project without leaving VS Code.",
  "version": "0.0.1",
  "publisher": "YGears",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ygears-lab/lorehub-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/ygears-lab/lorehub-vscode/issues"
  },
  "homepage": "https://github.com/ygears-lab/lorehub-vscode#readme",
  "keywords": [
    "ai",
    "claude",
    "claude-code",
    "cursor",
    "copilot",
    "agents.md",
    "skill.md",
    "cursorrules",
    "markdown",
    "prompt",
    "sync"
  ],
  "categories": [
    "AI",
    "Other"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#22272E",
    "theme": "dark"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.104.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "configuration": {
      "title": "LoreHub",
      "properties": {
        "lorehub.statusBar.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Show a LoreHub item in the status bar. It displays whether you are signed in, and clicking it signs you in or out."
        }
      }
    },
    "commands": [
      {
        "command": "lorehub.login",
        "title": "Login with GitHub",
        "category": "LoreHub"
      },
      {
        "command": "lorehub.logout",
        "title": "Logout",
        "category": "LoreHub"
      },
      {
        "command": "lorehub.openMdPanel",
        "title": "Open My md Files",
        "category": "LoreHub",
        "icon": "$(book)"
      },
      {
        "command": "lorehub.loadToProject",
        "title": "Load md into Project",
        "category": "LoreHub",
        "icon": "$(cloud-download)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "lorehub.login",
          "when": "!lorehub.authenticated"
        },
        {
          "command": "lorehub.logout",
          "when": "lorehub.authenticated"
        }
      ],
      "editor/title": [
        {
          "command": "lorehub.openMdPanel",
          "when": "resourceFilename =~ /^(CLAUDE|AGENTS|SKILL)\\.md$|^\\.cursorrules$/i",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "lorehub.loadToProject",
          "when": "explorerResourceIsFolder",
          "group": "7_modification@1"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "lorehub.gettingStarted",
        "title": "Get started with LoreHub",
        "description": "Sign in, open your cloud-synced library of AI config files, and load one into the project you are working on.",
        "featuredFor": [
          "CLAUDE.md",
          "AGENTS.md",
          "SKILL.md",
          ".cursorrules"
        ],
        "steps": [
          {
            "id": "signIn",
            "title": "Sign in with GitHub",
            "description": "Your library lives with your account, not with this machine, so the same md files are waiting on every computer you sign in from.\n[Sign in with GitHub](command:lorehub.login)",
            "media": {
              "svg": "media/walkthrough/sign-in.svg",
              "altText": "Two computers sharing one cloud-synced md library"
            },
            "completionEvents": [
              "onContext:lorehub.authenticated"
            ]
          },
          {
            "id": "openLibrary",
            "title": "Open your md library",
            "description": "Browse, write and organise your CLAUDE.md, AGENTS.md, SKILL.md and .cursorrules files in one panel. Labels keep them findable once the collection grows.\n[Open My md Files](command:lorehub.openMdPanel)",
            "media": {
              "svg": "media/walkthrough/library.svg",
              "altText": "The LoreHub panel: labels, a file list and an editor"
            },
            "completionEvents": [
              "onCommand:lorehub.openMdPanel"
            ]
          },
          {
            "id": "loadIntoProject",
            "title": "Load an md into this project",
            "description": "Pick a file from your library and write it into the folder you choose. Right-clicking a folder in the Explorer loads straight into it.\n[Load md into Project](command:lorehub.loadToProject)",
            "media": {
              "svg": "media/walkthrough/load.svg",
              "altText": "An md file moving from the library into a project folder"
            },
            "completionEvents": [
              "onCommand:lorehub.loadToProject"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.104.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "supabase": "^2.116.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
