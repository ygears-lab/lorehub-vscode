# Copy to `.env` and fill in. `esbuild.js` inlines these into dist/extension.js at build time.
# The anon key is a public key by design; access is controlled by Supabase Row Level Security.
LOREHUB_SUPABASE_URL=http://127.0.0.1:54321
LOREHUB_SUPABASE_ANON_KEY=

# Only needed to run GitHub OAuth against a local Supabase stack (`supabase start`).
# Referenced by [auth.external.github] in supabase/config.toml.
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# --- Release builds -------------------------------------------------------
# `npm run package` reads `.env.production.local` (gitignored) in preference to
# `.env`, and fails the build if the URL still points at localhost. Put the
# production Supabase URL and anon key there:
#
#   LOREHUB_SUPABASE_URL=https://<project-ref>.supabase.co
#   LOREHUB_SUPABASE_ANON_KEY=<production anon key>
